# Copy these values into Vercel Project Settings > Environment Variables.
# Supabase server keys are server-only. Never put them in index.html or any browser-exposed variable.
PUBLIC_ORIGIN=https://aleph-first-homework.vercel.app
WEBAUTHN_RP_ID=aleph-first-homework.vercel.app
WEBAUTHN_RP_NAME=AI Engineer Portfolio private space
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the modern sb_secret_... key when your project provides it.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
SESSION_TTL_SECONDS=28800
