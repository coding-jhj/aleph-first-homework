# Copy these values into Vercel Project Settings > Environment Variables.
# Never put the server secret in index.html or any browser-exposed variable.
PUBLIC_ORIGIN=https://aleph-first-homework.vercel.app
WEBAUTHN_RP_ID=aleph-first-homework.vercel.app
WEBAUTHN_RP_NAME=AI Engineer Portfolio private space
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Transitional fallback for an older Supabase project; prefer SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
SESSION_TTL_SECONDS=28800
