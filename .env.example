# Copy these values into Vercel Project Settings > Environment Variables.
# DATABASE_URL is server-only. Never put it in index.html or any browser-exposed variable.
PUBLIC_ORIGIN=https://aleph-first-homework.vercel.app
WEBAUTHN_RP_ID=aleph-first-homework.vercel.app
WEBAUTHN_RP_NAME=AI Engineer Portfolio private space
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
SESSION_TTL_SECONDS=28800
